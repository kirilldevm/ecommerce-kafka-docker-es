# --- PostgreSQL ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5433

# Prisma CLI on host only (localhost + mapped port)
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5433/ecommerce?schema=public

# --- Redis ---
REDIS_PORT=6379

# --- Auth / JWT (used by auth-service and later api-gateway) ---
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=604800

# --- Service ports (each container gets PORT from its *_SERVICE_PORT) ---
AUTH_SERVICE_PORT=3006
PRODUCT_SERVICE_PORT=3007
ORDER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
GATEWAY_PORT=8000

# Internal URLs for api-gateway (Docker network hostnames)
AUTH_SERVICE_URL=http://auth-service:3006
PRODUCT_SERVICE_URL=http://product-service:3007
ORDER_SERVICE_URL=http://order-service:3001

# --- Zookeeper ---
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# --- Kafka ---
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,PLAINTEXT_HOST://0.0.0.0:9092
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVER=kafka:29092
KAFKA_BROKERS=localhost:9092
KAFKA_BROKERS_DOCKER=kafka:29092
KAFKA_CLIENT_ID=ecommerce

# --- Kafka UI ---
KAFKA_UI_PORT=8080
KAFKA_CLUSTERS_0_NAME=local
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:29092
