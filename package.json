{
  "name": "kafka-ec-docker-ecommerce-app",
  "version": "1.0.0",
  "private": true,
  "description": "Event-driven e-commerce microservices with Kafka and Docker",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "shared",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @ecommerce/shared",
    "prisma:generate": "prisma generate --schema=shared/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=shared/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=shared/prisma/schema.prisma",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "dev:infra": "docker compose up -d --build",
    "dev:infra:down": "docker compose down",
    "install:all": "npm install"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "prisma": "^5.9.0",
    "typescript": "^5.8.3"
  }
}
